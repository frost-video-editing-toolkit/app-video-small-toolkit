{
  "name": "video-editing-toolkit",
  "version": "1.0.0",
  "description": "Tauri and Go video toolkit powered by FFmpeg",
  "author": "Frost",
  "scripts": {
    "react:start": "npm --prefix ui start",
    "react:build": "npm --prefix ui run build",
    "worker:build": "node scripts/build-worker.js",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run worker:build && npm run react:build && tauri build",
    "check-ffmpeg": "node ./scripts/check-ffmpeg.js",
    "test": "npm --prefix ui test -- --watchAll=false",
    "test:integration": "node test/integration-test.js"
  },
  "keywords": [
    "tauri",
    "go",
    "react",
    "ffmpeg",
    "video"
  ],
  "license": "ISC",
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1"
  }
}
